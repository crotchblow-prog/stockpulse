# Basic-auth credentials for /v2/* preview gate (M1-M3 protect-by-default).
# When BOTH are set, the middleware in middleware.ts gates /v2/*.
# When EITHER is empty/missing, the gate is fail-open (no 401).
#
# Production: set these in Vercel project env vars.
# Local dev: copy to web/.env.local with real values.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
