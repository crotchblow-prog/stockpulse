# StockPulse — copy to .env.local and fill in. Never commit .env or .env.local.

# ── Phase 1 (no secrets required for the MVP) ────────────────────────────────
# yfinance pulls public data; no key needed.

# ── Phase 2 (Claude API synthesis) ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Phase 2 (Finnhub earnings calendar — free tier) ───────────────────────────
# Optional. If absent, the earnings fetcher returns None per symbol and the
# report still ships.
FINNHUB_API_KEY=

# ── Phase 2 (Vercel auto-deploy hook — used by scripts/run_daily.sh) ──────────
# Optional. If set, the daily cron pings this hook after pushing to redeploy
# Vercel without relying on the (currently unreliable) GitHub git integration.
# Create one at: Vercel project → Settings → Git → Deploy Hooks.
VERCEL_DEPLOY_HOOK=

# ── Phase 3 (Telegram push) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Phase 3 (Supabase history) ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the report's "as of" date for backfills (YYYY-MM-DD, Asia/Taipei).
# REPORT_DATE=
